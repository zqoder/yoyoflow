{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YoYoFlow",
  "version": "0.1.0",
  "identifier": "com.zhaoqi.yoyoflow",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "YoYoFlow",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      },
      {
        "label": "shortcut_translate",
        "title": "YoYoFlow",
        "url": "/shortcut-translate",
        "width": 600,
        "height": 450,
        "minWidth": 400,
        "minHeight": 300,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "hiddenTitle": true,
        "visible": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
